{
  "_help": "every key, its allowed values and examples per agent CLI: harness/help/config.md",
  "base_branch": "main",
  "test_cmd": "uv run pytest -q",
  "setup_cmd": "uv sync",
  "copy_files": [
    ".env"
  ],
  "teardown_cmd": "",
  "max_review_rounds": 3,
  "gates": {
    "approve": "auto",
    "merge": "auto"
  },
  "agents": {
    "orchestrator": {
      "kind": "claude",
      "model": "claude-opus-5-5",
      "effort": "medium",
      "args": [
        "--dangerously-skip-permissions"
      ]
    },
    "spec_author": {
      "kind": "claude",
      "model": "claude-fable-5-1",
      "effort": "xhigh",
      "args": [
        "--dangerously-skip-permissions"
      ]
    },
    "implementer": {
      "kind": "claude",
      "model": "claude-opus-5-5",
      "effort": "high",
      "args": [
        "--dangerously-skip-permissions"
      ]
    },
    "reviewer": {
      "kind": "codex",
      "model": "gpt-6-astra",
      "effort": "xhigh",
      "args": [
        "--dangerously-bypass-approvals-and-sandbox"
      ]
    }
  }
}
