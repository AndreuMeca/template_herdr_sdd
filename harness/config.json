{
  "_help": "every key, its allowed values and what each CLI is given: harness/help/config.md",
  "base_branch": "main",
  "test_cmd": "uv run pytest -q",
  "setup_cmd": "uv sync",
  "copy_files": [
    ".env"
  ],
  "teardown_cmd": "",
  "max_review_rounds": 3,
  "max_role_minutes": 180,
  "gates": {
    "approve": "auto",
    "merge": "auto"
  },
  "agents": {
    "orchestrator": {
      "kind": "claude",
      "model": "claude-opus-5-5",
      "effort": "medium",
      "permissions": "full"
    },
    "spec_author": {
      "kind": "claude",
      "model": "claude-fable-5-1",
      "effort": "extra",
      "permissions": "full"
    },
    "implementer": {
      "kind": "claude",
      "model": "claude-opus-5-5",
      "effort": "high",
      "permissions": "full"
    },
    "reviewer": {
      "kind": "codex",
      "model": "gpt-6-astra",
      "effort": "extra",
      "permissions": "guarded"
    }
  }
}
